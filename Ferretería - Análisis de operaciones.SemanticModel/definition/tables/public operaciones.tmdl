		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Canal Limpio' =
			
			VAR C =
			    UPPER(
			        TRIM(
			            SUBSTITUTE(
			                SUBSTITUTE(
			                    'public operaciones'[canal],
			                    UNICHAR(160), " "
			                ),
			                UNICHAR(8203), ""
			            )
			        )
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        C IN {"", "??", "N/A", "SIN CANAL"}, "Sin canal",
			        C IN {"DIGITAL", "DIGTAL", "DÍGITAL"}, "Digital",
			        C = "PRESENCIAL", "Presencial",
			        C IN {"TELEFONO", "TELÉFONO"}, "Teléfono",
			        C = "APP", "App",
			        "Canal por revisar"
			    )
		lineageTag: 72da92b7-3eed-422d-9579-8c00926b501a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'public operaciones' = m
		mode: import
		source =
				let
				  Origen = PostgreSQL.Database("ep-sweet-resonance-bdm3rdcz-pooler.c-8.us-east-2.aws.neon.tech", "ferreteria"),
				  #"Navegación 1" = Origen{[Schema = "public", Item = "operaciones"]}[Data],
				  Personalizado = Table.TransformColumns(
				    Origen{[Schema = "public", Item = "operaciones"]}[Data],
				    {
				        {"estado", each
				            if _ = null then "desconocido"
				            else if Text.Trim(Text.Clean(_)) = "" then "desconocido"
				            else Text.Lower(Text.Trim(Text.Clean(_))), type text},
				
				        {"canal", each
				            if _ = null then "Sin canal"
				            else if Text.Trim(Text.Clean(_)) = "" then "Sin canal"
				            else Text.Proper(Text.Trim(Text.Clean(_))), type text},
				
				        {"fecha", each Date.From(_), type nullable date}
				    }
				),
				  #"Personalizado 1" = Table.AddColumn(
				    Personalizado,
				    "mes",
				    each if [fecha] = null then null
				    else Date.StartOfMonth([fecha]),
				    type nullable date
				)
				in
				  #"Personalizado 1"

	annotation PBI_ResultType = Table

